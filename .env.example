# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Blob (private store). Added automatically when you connect a Blob store to the project.
# Leave empty locally to keep using the .data/uploads folder.
BLOB_READ_WRITE_TOKEN=

# Optional: extra admins by email (comma separated). Admins can open /admin to resolve reports and support requests.
ADMIN_EMAILS=
